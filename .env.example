# Supabase Configuration
# Create a free project at https://supabase.com and copy your credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site URL (used for canonical URLs, OG images, etc.)
# For GitHub Pages: https://<username>.github.io/TeknyCampo-web
# For custom domain: https://teknycampo.com
VITE_SITE_URL=https://teknycampo.com

# Base path for routing and assets
# For GitHub Pages (subdirectory): /TeknyCampo-web
# For custom domain (root): /
VITE_BASE_PATH=/TeknyCampo-web
