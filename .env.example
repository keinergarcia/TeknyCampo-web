# ===== REQUERIDO =====
# URL del proyecto Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
# Clave anónima pública de Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===== OPCIONAL (producción recomendado) =====

# URL canónica para SEO y Open Graph
# Ejemplo: https://teknycampo.com
# Default: window.location.origin
VITE_SITE_URL=https://teknycampo.com

# Base path para assets y React Router
# Usar / para dominio personalizado o desarrollo local
# Usar /TeknyCampo-web para GitHub Pages (subdirectorio)
# Default: /
VITE_BASE_PATH=/
